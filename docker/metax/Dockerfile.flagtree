# Compatibility entry point; keep the recipe aligned with docker/metax/Dockerfile.
ARG METAX_BASE_IMAGE=cr.metax-tech.com/public-ai-release/maca/vllm-metax:0.20.2-maca.ai3.7.0.107-torch2.8-py312-ubuntu22.04-pd
FROM ${METAX_BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG FLAGTREE_VERSION=0.7.0.post2+metax3.6
ARG FLAGTREE_INDEX_URL=https://resource.flagos.net/repository/flagos-pypi-hosted/simple

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        openssh-client \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN /opt/conda/bin/python3 -m pip uninstall -y triton flagtree \
    && /opt/conda/bin/python3 -m pip install --no-cache-dir \
        --only-binary=:all: --no-deps \
        --index-url "${FLAGTREE_INDEX_URL}" \
        "flagtree===${FLAGTREE_VERSION}"

RUN /opt/conda/bin/python3 -m pip install --no-cache-dir --no-deps \
        setuptools==69.5.1 \
        wheel==0.45.1 \
        PyYAML==6.0.3 \
        pytest==8.4.1

RUN TORCH_DEVICE_BACKEND_AUTOLOAD=0 /opt/conda/bin/python3 -c \
    'import sys, importlib.metadata, torch, triton; print("Python:", sys.executable, sys.version); print("Torch:", torch.__version__); print("FlagTree:", importlib.metadata.version("flagtree")); print("Triton:", triton.__version__, triton.__file__)'

COPY . /workspace/FlagRAND
COPY docker/metax/entrypoint.sh /usr/local/bin/flagrand-metax-entrypoint

RUN chmod 0755 \
        /usr/local/bin/flagrand-metax-entrypoint \
        /workspace/FlagRAND/docker/metax/build.sh \
        /workspace/FlagRAND/docker/metax/run.sh \
    && /opt/conda/bin/python3 -m pip install \
        --no-deps --no-build-isolation -e /workspace/FlagRAND

ENV MACA_HOME=/opt/maca \
    MACA_PATH=/opt/maca \
    FLAGRAND_VENDOR=metax \
    FLAGRAND_MCRAND_PATH=/opt/maca/lib/libmcrand.so \
    FLAGRAND_USE_LIBTUNER=0 \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 \
    PYTHONPATH=/workspace/FlagRAND/src:/workspace/FlagRAND \
    PYTHON_BIN=/opt/conda/bin/python3 \
    TRITON_CACHE_DIR=/workspace/FlagRAND/.triton_cache_metax36 \
    FLAGTREE_CACHE_DIR=/workspace/FlagRAND/.flagtree_cache_metax36 \
    XDG_CACHE_HOME=/workspace/FlagRAND/.cache_metax36 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

WORKDIR /workspace/FlagRAND
ENTRYPOINT ["/usr/local/bin/flagrand-metax-entrypoint"]
CMD ["bash"]
